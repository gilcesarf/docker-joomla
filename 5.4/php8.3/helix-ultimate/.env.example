# Copiar a .env antes del primer uso: cp .env.example .env
# Valores de ejemplo; ajustar contraseñas y URL del quickstart según tu caso.

# URL HTTPS del .zip quickstart (ej.: paquete Helix Ultimate Joomla 5 en JoomShaper)
HELIX_QUICKSTART_URL=https://www.joomshaper.com/downloads/template/helixultimate/2-quickstart-pack-joomla-5

# Opcional: SHA-512 del zip para verificar integridad en el build
HELIX_QUICKSTART_SHA512=

# Nombre de la imagen local tras docker compose build
JOOMLA_HELIX_IMAGE=joomla-helix-ultimate:5.4-php8.3

# MySQL: usar contraseña fuerte; debe coincidir con lo que usa joomla-app para conectar
MYSQL_ROOT_PASSWORD=changeme
JOOMLA_DB_NAME=joomla
JOOMLA_DB_USER=root

# Rutas en el host (relativas al docker-compose.yml)
JOOMLA_HOST_APP_DIR=./app
MYSQL_HOST_DATA_DIR=./database

MYSQL_PORT=3306
JOOMLA_HTTP_PORT=8080
