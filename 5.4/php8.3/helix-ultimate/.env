# Quickstart Helix Ultimate (Joomla 5) — descarga directa desde JoomShaper
HELIX_QUICKSTART_URL=https://www.joomshaper.com/downloads/template/helixultimate/2-quickstart-pack-joomla-5

# Opcional: verificación de integridad del zip (dejar vacío si no la usas)
HELIX_QUICKSTART_SHA512=

# Imagen resultante del build
JOOMLA_HELIX_IMAGE=joomla-helix-ultimate:5.4-php8.3

# MySQL / Joomla (misma contraseña que usa joomla-app para conectar)
MYSQL_ROOT_PASSWORD=MySecretPassword123
JOOMLA_DB_NAME=joomla
JOOMLA_DB_USER=root

# Puertos en el host
MYSQL_PORT=3306
JOOMLA_HTTP_PORT=8080
